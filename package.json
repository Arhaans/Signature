{
  "name": "signature",
  "version": "0.1.0",
  "description": "Local e-signature app: sign PDF and Word documents with ready-made, drawn or uploaded signatures.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@fontsource/allura": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
